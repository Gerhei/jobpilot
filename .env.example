# Database (async для FastAPI, sync для Celery)
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot@db:5432/jobpilot
DATABASE_URL_SYNC=postgresql+psycopg2://jobpilot:jobpilot@db:5432/jobpilot

# Redis (broker + dedup + circuit breaker)
REDIS_URL=redis://redis:6379/0

# hh.ru API
HH_API_BASE_URL=https://api.hh.ru
HH_SEARCH_KEYWORDS=python developer
HH_AREA_ID=1
HH_SALARY_FROM=0
HH_SALARY_TO=0

# Курсы валют (фиксированные)
USD_TO_RUB=90.0
EUR_TO_RUB=100.0
KZT_TO_RUB=0.21

# Эталонный стек для скора релевантности
REFERENCE_SKILLS=python,fastapi,postgresql,redis,celery,docker,sqlalchemy,alembic

# Circuit breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=3600

# Rate limit на POST /tasks/fetch (секунды)
FETCH_RATE_LIMIT_SECONDS=300
